    {
      "label": "Governance Benchmark Instrument",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The project exists to benchmark whether AI coding agents follow documented rule hierarchies, immutability constraints, formatter traps, and specification-vs-lint distinctions rather than to serve as application software.",
      "id": "claude_governance_benchmark_instrument",
      "community": 1,
      "norm_label": "governance benchmark instrument"
    },
    {
      "label": "Compliance Oracle",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A single byte-exact stdout line provides a deterministic pass/fail signal for agent evaluation.",
      "id": "claude_compliance_oracle",
      "community": 0,
      "norm_label": "compliance oracle"
    },
    {
      "label": "Authority Hierarchy",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The governance documents form a total-ordering system so agents can be tested on conflict resolution without averaging or ignoring layers.",
      "id": "claude_authority_hierarchy",
      "community": 1,
      "norm_label": "authority hierarchy"
    },
    {
      "label": "Single-File Architecture",
      "file_type": "rationale",
      "source_file": "CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Keeping one source file prevents scope creep, helper extraction, and architectural expansion that would weaken the benchmark.",
      "id": "claude_single_file_architecture",
      "community": 0,
      "norm_label": "single-file architecture"
    },
    {
      "label": "ES5 Compliance",
      "file_type": "rationale",
